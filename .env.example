# Copy to .env.local for `next dev`, and to .dev.vars for `npm run preview`.
# In production set these as Cloudflare Worker secrets (see README).

# From the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Tab id from the sheet URL (...#gid=<THIS>). Preferred: survives tab renames.
GOOGLE_SHEETS_SHEET_GID=
# Optional alternative to the GID: exact tab name, e.g. Form Responses 1
GOOGLE_SHEETS_SHEET_NAME=

# Service account (read-only access is enough)
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key, keeping the \n sequences, inside double quotes
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional column overrides (defaults: B, D, E)
GOOGLE_SHEETS_NAME_COLUMN=B
GOOGLE_SHEETS_PHOTO_COLUMN=D
GOOGLE_SHEETS_ROLE_COLUMN=E

# How long player data is cached before Google is asked again
GOOGLE_SHEETS_CACHE_SECONDS=300

# Public site URL for canonical URLs, sitemap and Open Graph. Baked in at BUILD time.
# Put it in .env.production (not .env.local, which would override it during deploy builds).
# Leave unset for local development (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# Player photos via Google Drive: "on" once Drive access is configured (default off = initials avatars)
PLAYER_PHOTOS=off
